# ==============================================================================
# MarginPilot AI — Frontend Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local and configure your values:
# cp .env.example .env.local

# --- FastAPI Backend API Gateway ---
# Base URL for the FastAPI Backend REST API (must point to /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- Client Runtime Environment ---
NEXT_PUBLIC_APP_ENV=development

# --- Application Title & Branding ---
NEXT_PUBLIC_APP_NAME="MarginPilot AI"
