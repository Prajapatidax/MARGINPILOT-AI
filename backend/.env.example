# ==============================================================================
# MarginPilot AI — Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your values:
# cp .env.example .env (or cp env.example .env)

# --- Application Configuration ---
PROJECT_NAME="MarginPilot AI"
ENVIRONMENT=development
API_V1_STR=/api/v1

# --- Security & JWT Authentication ---
# Generate a cryptographically secure 64-char key in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=marginpilot_super_secret_jwt_signing_key_change_in_production_38472938472
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Database Configuration (Neon Serverless PostgreSQL) ---
# Neon PostgreSQL connection string with SSL required:
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
# MarginPilot AI automatically adapts this to 'postgresql+psycopg://' with connection pooling.
# For local offline dev/testing, SQLite fallback is supported: sqlite:///./marginpilot.db
DATABASE_URL=postgresql://neondb_owner:npg_secretpassword@ep-xyz-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- CORS Authorized Origins ---
# Comma-separated list of origins permitted to make cross-origin requests
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Upstash Redis (Caching & Job Queue) ---
# Upstash supports both REST API (serverless friendly) and standard TLS rediss://
# Option 1: Upstash REST API (Recommended for serverless & edge)
UPSTASH_REDIS_REST_URL=https://upstash-instance-xyz.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# Option 2: Upstash TLS Redis Protocol (rediss://)
REDIS_URL=rediss://default:your_upstash_password@upstash-instance-xyz.upstash.io:6379

# --- Neon Bucket Document Storage (S3-Compatible) ---
# Neon Object Storage bucket for business documents, CSV/XLSX imports, and PDF reports
NEON_STORAGE_ENDPOINT=https://storage.neon.tech
NEON_STORAGE_ACCESS_KEY=your_neon_storage_access_key
NEON_STORAGE_SECRET_KEY=your_neon_storage_secret_key
NEON_STORAGE_BUCKET=marginpilot-docs
NEON_STORAGE_REGION=us-east-1

# --- Google Gemini AI API ---
# Obtain your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- MLOps Experiment Tracking (Optional) ---
MLFLOW_TRACKING_URI=./artifacts/mlruns

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-google-app-password"  # 16-character App Password from Google Account Security
SMTP_FROM_EMAIL="your-email@gmail.com"
SMTP_FROM_NAME="MarginPilot AI"
